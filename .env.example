# SYNAPSE local configuration template.
# Copy to `.env` for local runs. Never commit a populated `.env`.

DEMO_MODE=true
GOLDEN_RESULT_PATH=tests/fixtures/demo_golden.json

# Default demo query. Keep it general — not tied to a specific program.
DEMO_QUERY="What are the strongest evidence-backed approaches for building a trustworthy AI research assistant for students, researchers, and builders?"

# Search and source fetching
SEARCH_PROVIDER=duckduckgo,arxiv
DDGS_REGION=wt-wt
DDGS_SAFESEARCH=moderate
DDGS_TIMEOUT_SECONDS=15
ARXIV_MAX_RESULTS=5
ARXIV_TIMEOUT_SECONDS=10
SOURCE_FETCH_ENABLED=true
SOURCE_FETCH_TIMEOUT_SECONDS=20
SOURCE_FETCH_MAX_CHARS=12000
SOURCE_FETCH_HTTP_FIRST=true
SOURCE_FETCH_MIN_TEXT_CHARS=500

# Optional browser fallback for public JS-heavy pages
CAMOFOX_ENABLED=false
CAMOFOX_BASE_URL=http://localhost:9377
CAMOFOX_HEALTH_PATH=/health
CAMOFOX_FETCH_PATH=
CAMOFOX_TIMEOUT_SECONDS=30
CAMOFOX_SCREENSHOT=false

# LLM provider
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_MODEL=gemini-2.5-pro

# Gemini reasoning controls. Empty values preserve provider defaults.
GEMINI_THINKING_BUDGET=
GEMINI_INCLUDE_THOUGHTS=false

# Per-stage model overrides. Empty provider values reuse LLM_PROVIDER.
PLANNER_PROVIDER=
PLANNER_MODEL=gemini-2.5-pro
EXTRACTION_PROVIDER=
EXTRACTION_MODEL=gemini-2.5-flash
FACT_CHECKER_PROVIDER=
FACT_CHECKER_MODEL=gemini-2.5-flash
COVERAGE_AUDITOR_PROVIDER=
COVERAGE_AUDITOR_MODEL=gemini-2.5-pro
SYNTHESIZER_PROVIDER=
SYNTHESIZER_MODEL=gemini-2.5-pro

# Stage budgets and concurrency
LLM_TIMEOUT_SECONDS=120
LLM_STAGE_TIMEOUT_SECONDS=120
LLM_MAX_CONCURRENT_CALLS=1
SYNTHESIZER_MAX_TOKENS=64000
SYNTHESIZER_REASONING_EFFORT=high
SYNTHESIZER_TEMPERATURE=0.2
EXTRACTION_MAX_TOKENS=64000
EXTRACTION_REASONING_EFFORT=high
EXTRACTION_MAX_CONCURRENT_CALLS=4

# Pipeline limits
MAX_SEARCH_HEADERS_TOTAL=20
MAX_FETCHED_SOURCES_TOTAL=10
SOURCE_CONTEXT_TOKENS=2000
SOURCE_DEEP_REVIEW_TOKENS=20000
ENABLE_DEEP_SOURCE_REVIEW=true
MAX_RESEARCH_ITERATIONS=1

# Gemini-native optional capabilities
GEMINI_GROUNDING_ENABLED=false
MULTIMODAL_ENABLED=false
LIVE_TOOL_AGENT_ENABLED=false

# Semantic reranker
SEMANTIC_RERANK_ENABLED=false
SEMANTIC_RERANK_MODEL=ms-marco-MiniLM-L-12-v2
SEMANTIC_RERANK_WEIGHT=2.0
SEMANTIC_RERANK_MIN_SCORE=0.01

# Temporary compatibility provider for testing only.
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=qwen3.6-plus
OPENCODE_GO_AUTH_HEADER=Authorization
OPENCODE_GO_AUTH_SCHEME=Bearer

# Test gates
RUN_LIVE_SEARCH_TESTS=false
RUN_LIVE_LLM_TESTS=false
RUN_CAMOFOX_TESTS=false
