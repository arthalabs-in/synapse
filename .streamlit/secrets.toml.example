# SYNAPSE — Streamlit Community Cloud secrets template.
#
# Copy this file to .streamlit/secrets.toml and fill in the Gemini API key.
# DO NOT COMMIT the populated secrets.toml. This .example file is safe to
# commit because it contains no real credentials.
#
# Streamlit reads these values and exposes them as environment variables
# to the Python process. config.py already uses os.getenv for every key,
# so nothing else needs to change.

# --- Required: Gemini provider ---
GEMINI_API_KEY = "your-google-ai-studio-key"
LLM_PROVIDER = "gemini"
GEMINI_MODEL = "gemini-2.5-pro"
GEMINI_BASE_URL = "https://generativelanguage.googleapis.com/v1beta"

# --- Demo defaults (safe to leave on for judges) ---
DEMO_MODE = "true"
GOLDEN_RESULT_PATH = "tests/fixtures/demo_golden.json"

# --- Optional: Gemini-native capability flags ---
# Flip these to "true" one at a time once the base flow is stable.
GEMINI_GROUNDING_ENABLED = "false"
MULTIMODAL_ENABLED = "false"
LIVE_TOOL_AGENT_ENABLED = "false"

# --- Optional: per-stage model overrides (Phase 1.2) ---
# Leave empty to reuse GEMINI_MODEL for every stage. Recommended split:
#   PLANNER_MODEL = "gemini-2.5-pro"
#   EXTRACTION_MODEL = "gemini-2.5-flash"
#   FACT_CHECKER_MODEL = "gemini-2.5-flash"
#   COVERAGE_AUDITOR_MODEL = "gemini-2.5-pro"
#   SYNTHESIZER_MODEL = "gemini-2.5-pro"

# --- Optional: reasoning + loop controls ---
# GEMINI_THINKING_BUDGET = "-1"   # -1 = dynamic, 0 = disabled, >0 = token cap
# GEMINI_INCLUDE_THOUGHTS = "false"
# MAX_RESEARCH_ITERATIONS = "2"   # 1 = current single-pass behavior
